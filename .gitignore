# ── Data lake ────────────────────────────────────────────────────────────────
# Contents are NEVER committed (Bronze is 15 GB of text; Silver 2.2 GB of Parquet).
# The folder STRUCTURE is committed, via .gitkeep, so a fresh clone is runnable.
data/**
!data/**/
!data/README.md
!data/**/.gitkeep

# Big-data file types, wherever they land
*.phhs
*.parquet
*.zip
*.tar.gz

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ── Spark scratch ────────────────────────────────────────────────────────────
spark-warehouse/
metastore_db/
derby.log
/tmp/spark-scratch/

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
data/phh-dataset/
